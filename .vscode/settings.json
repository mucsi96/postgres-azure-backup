{
    "rust-analyzer.linkedProjects": ["server/Cargo.toml"],
    "sqltools.connections": [
        {
            "previewLimit": 50,
            "server": "db",
            "port": 5432,
            "driver": "PostgreSQL",
            "name": "local",
            "database": "postgres-azure-backup",
            "username": "postgres",
            "password": "postgres"
        }
    ],
    "python.analysis.autoImportCompletions": true,
    "python.analysis.typeCheckingMode": "basic",
    "vs-kubernetes": {
        "vs-kubernetes.kubeconfig": "${workspaceFolder}/.kube/config"
    },
    "terminal.integrated.env.linux": {
        "KUBECONFIG": "${workspaceFolder}/.kube/config"
    }
}
