<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>postgres-azure-backup</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <java.version>21</java.version>
        <!-- Spring profile baked into the AOT-processed / native image at build
             time. GraalVM native images resolve their bean definitions during
             AOT processing, so the profile cannot be chosen at runtime any
             more: build one image per profile instead (test, prod). -->
        <app.profile>prod</app.profile>
    </properties>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version> <!-- Spring version mapping https://github.com/Azure/azure-sdk-for-java/wiki/Spring-Versions-Mapping -->
        <relativePath /> <!-- lookup parent from repository -->
    </parent>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.azure.spring</groupId>
                <artifactId>spring-cloud-azure-dependencies</artifactId>
                <version>7.4.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Ahead of the version the Azure BOM pins (1.58.1), whose
                 native-image.properties forces SLF4J and logback to build-time
                 initialization. Spring Boot sets logging up at run time, and
                 the mix leaves objects of run-time initialized types in the
                 image heap, which the native-image builder rejects and refuses
                 to let the build override. 1.59.0 dropped those directives. -->
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-core</artifactId>
                <version>1.59.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.azure.spring</groupId>
            <artifactId>spring-cloud-azure-starter-storage-blob</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-core-http-netty</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.azure.spring</groupId>
            <artifactId>spring-cloud-azure-starter-keyvault-secrets</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-core-http-netty</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Use JDK HTTP client instead of Netty for Azure SDK (Netty 4.1 vs 4.2 incompatibility with Spring Boot 4) -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-core-http-jdk-httpclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.22.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- JDK 23 stopped running annotation processors that are
                         merely on the classpath, so Lombok has to be named as a
                         processor explicitly. Without this the build tool chain
                         (JDK 25) compiles every Lombok-generated member away and
                         fails with "cannot find symbol: variable log". -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <addResources>true</addResources>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>process-aot</id>
                        <configuration>
                            <profiles>
                                <profile>${app.profile}</profile>
                            </profiles>
                            <!-- AOT processing refreshes the application
                                 context at build time, so every placeholder an
                                 auto-configuration condition reads has to
                                 resolve. These are build-time-only stand-ins:
                                 they are never baked into the image, but the
                                 conditions they make match are, so a stand-in
                                 has to match what the real value does at
                                 runtime. Deliberately absent: the Key Vault
                                 endpoint, which is what the property source
                                 (switched off here so the build never reaches
                                 out to Azure) would supply. -->
                            <systemPropertyVariables>
                                <spring.cloud.azure.keyvault.secret.property-source-enabled>false</spring.cloud.azure.keyvault.secret.property-source-enabled>
                                <SPRING_ACTUATOR_PORT>8162</SPRING_ACTUATOR_PORT>
                                <storage-account-container-name>backups</storage-account-container-name>
                                <storage-account-blob-url>https://aot-build.blob.core.windows.net/</storage-account-blob-url>
                                <api-client-id>aot-build</api-client-id>
                                <BLOBSTORAGE_CONNECTION_STRING>aot-build-placeholder</BLOBSTORAGE_CONNECTION_STRING>
                                <DATABASES_CONFIG_PATH>/app/databases_config.json</DATABASES_CONFIG_PATH>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <configuration>
                    <!-- Pull reachability metadata for libraries that do not
                         ship their own (the PostgreSQL JDBC driver, ...). -->
                    <metadataRepository>
                        <enabled>true</enabled>
                    </metadataRepository>
                    <buildArgs>
                        <!-- musl, to match the Alpine runtime image. Not
                             --static: a fully static binary segfaulted on
                             startup in the container, before GraalVM's own
                             segfault handler was installed and so with no
                             output at all, while the same build ran fine
                             outside one. Dynamic musl is what the Liberica NIK
                             musl image is built to produce. -->
                        <buildArg>--libc=musl</buildArg>
                        <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                        <!-- azure-core build-time initializes a few Jackson
                             core classes but not everything they hold on to,
                             which would leave objects of run-time initialized
                             types in the image heap. Naming those types one by
                             one was tried first and turned into whack-a-mole
                             (Base64Variants pulls in Base64Variant, which pulls
                             in its nested PaddingReadBehaviour), hence the whole
                             package. -->
                        <buildArg>--initialize-at-build-time=com.fasterxml.jackson.core</buildArg>
                        <!-- See native-image.security for why the builder has
                             to ignore jar signatures. -->
                        <buildArg>-J-Djava.security.properties=${project.basedir}/native-image.security</buildArg>
                    </buildArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
