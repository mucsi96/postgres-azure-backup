{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "groupName": "all dependencies",
  "groupSlug": "all",
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "separateMinorPatch": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^test\\/test-pod\\.yaml$/"],
      "matchStrings": ["image:\\s*(?<depName>ghcr\\.io/mucsi96/mock-oidc-provider):(?<currentValue>[1-9][0-9]*)\\b"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Angular 22 requires TypeScript >=6.0 <6.1; review this range when upgrading Angular.",
      "matchManagers": ["npm"],
      "matchFileNames": ["client/package.json"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": ">=6.0 <6.1"
    },
    {
      "groupName": "all dependencies",
      "groupSlug": "all",
      "matchPackageNames": [
        "*"
      ]
    }
  ],
  "labels": [
    "dependencies"
  ],
  "github-actions": {
    "enabled": false
  }
}
